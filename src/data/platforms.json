[
  {
    "id": "shopify",
    "name": "Shopify",
    "file": "Shopify product CSV export/import",
    "summary": "Shopify's product CSV uses one row per variant. The Handle column ties variants of the same product together; only the first row of a handle needs the shared product fields.",
    "notes": [
      "Every row of a product family repeats the same Handle. Rows after the first may leave Title, Body (HTML) and Vendor blank.",
      "Variant Grams is a whole number of grams, not kilograms.",
      "Published and the boolean columns accept TRUE / FALSE.",
      "Extra images are added as additional rows with only Handle and Image Src filled in."
    ],
    "columns": [
      { "name": "Handle", "canonical": "handle", "required": true, "note": "URL slug; groups variant rows together." },
      { "name": "Title", "canonical": "title", "required": true },
      { "name": "Body (HTML)", "canonical": "description", "note": "HTML is allowed." },
      { "name": "Vendor", "canonical": "brand" },
      { "name": "Product Category", "canonical": "category", "note": "Shopify's standard product taxonomy string." },
      { "name": "Type", "canonical": "productType" },
      { "name": "Tags", "canonical": "tags", "note": "Comma separated." },
      { "name": "Published", "canonical": "published", "note": "TRUE / FALSE" },
      { "name": "Option1 Name", "canonical": "option1Name" },
      { "name": "Option1 Value", "canonical": "option1Value" },
      { "name": "Option2 Name", "canonical": "option2Name" },
      { "name": "Option2 Value", "canonical": "option2Value" },
      { "name": "Option3 Name", "canonical": "option3Name" },
      { "name": "Option3 Value", "canonical": "option3Value" },
      { "name": "Variant SKU", "canonical": "sku" },
      { "name": "Variant Grams", "canonical": "weightGrams", "note": "Whole grams." },
      { "name": "Variant Inventory Tracker", "note": "shopify, or blank for untracked." },
      { "name": "Variant Inventory Qty", "canonical": "quantity" },
      { "name": "Variant Inventory Policy", "note": "deny / continue" },
      { "name": "Variant Fulfillment Service", "note": "manual" },
      { "name": "Variant Price", "canonical": "price", "required": true },
      { "name": "Variant Compare At Price", "canonical": "compareAtPrice" },
      { "name": "Variant Requires Shipping", "note": "TRUE / FALSE" },
      { "name": "Variant Taxable", "note": "TRUE / FALSE" },
      { "name": "Variant Barcode", "canonical": "gtin", "note": "UPC / EAN / ISBN." },
      { "name": "Image Src", "canonical": "imageMain", "note": "Publicly reachable https URL." },
      { "name": "Image Position", "note": "1 for the main image." },
      { "name": "Image Alt Text", "canonical": "imageAlt" },
      { "name": "Gift Card", "note": "TRUE / FALSE" },
      { "name": "SEO Title", "canonical": "seoTitle" },
      { "name": "SEO Description", "canonical": "seoDescription" },
      { "name": "Variant Weight Unit", "canonical": "weightUnit", "note": "g / kg / lb / oz" },
      { "name": "Cost per item", "canonical": "cost" },
      { "name": "Status", "canonical": "status", "note": "active / draft / archived" }
    ]
  },
  {
    "id": "amazon-flat-file",
    "name": "Amazon flat file (product upload)",
    "file": "Category listings template, Template tab",
    "summary": "Amazon's category templates share a common core of columns. The exact set varies per category, so always start from a freshly downloaded template for your product type and paste your data into it.",
    "notes": [
      "The template has two header rows above the data; never delete them.",
      "feed_product_type must match the category template you downloaded.",
      "Leave price, quantity and external_product_id blank on parent rows of a variation family.",
      "Format identifier columns as Text in Excel so leading zeros survive."
    ],
    "columns": [
      { "name": "item_sku", "canonical": "sku", "required": true },
      { "name": "external_product_id", "canonical": "gtin", "note": "UPC, EAN, GTIN or ASIN." },
      { "name": "external_product_id_type", "canonical": "gtinType", "note": "UPC / EAN / GTIN / ASIN" },
      { "name": "item_name", "canonical": "title", "required": true, "note": "The product title, usually capped around 200 characters." },
      { "name": "brand_name", "canonical": "brand", "required": true },
      { "name": "manufacturer", "canonical": "manufacturer" },
      { "name": "part_number", "canonical": "mpn" },
      { "name": "product_description", "canonical": "description", "note": "Limited HTML only." },
      { "name": "bullet_point1", "canonical": "bullet1" },
      { "name": "bullet_point2", "canonical": "bullet2" },
      { "name": "bullet_point3", "canonical": "bullet3" },
      { "name": "bullet_point4", "canonical": "bullet4" },
      { "name": "bullet_point5", "canonical": "bullet5" },
      { "name": "generic_keywords", "canonical": "keywords", "note": "Space separated search terms." },
      { "name": "standard_price", "canonical": "price", "required": true, "note": "Plain decimal, no currency symbol." },
      { "name": "quantity", "canonical": "quantity", "note": "Leave blank for FBA SKUs." },
      { "name": "main_image_url", "canonical": "imageMain", "required": true },
      { "name": "other_image_url1", "canonical": "image2" },
      { "name": "other_image_url2", "canonical": "image3" },
      { "name": "other_image_url3", "canonical": "image4" },
      { "name": "feed_product_type", "canonical": "productType", "required": true },
      { "name": "item_type", "canonical": "category", "note": "Category-specific item type keyword." },
      { "name": "condition_type", "canonical": "condition", "note": "new_new, used_good, ..." },
      { "name": "parent_child", "canonical": "parentChild", "note": "parent / child, blank for standalone items." },
      { "name": "parent_sku", "canonical": "parentSku" },
      { "name": "relationship_type", "canonical": "relationshipType", "note": "variation" },
      { "name": "variation_theme", "canonical": "variationTheme", "note": "SizeColor, ColorName, ..." },
      { "name": "color_name", "canonical": "option1Value" },
      { "name": "size_name", "canonical": "option2Value" },
      { "name": "item_weight", "canonical": "weight" },
      { "name": "item_weight_unit_of_measure", "canonical": "weightUnit", "note": "GR / KG / LB / OZ" },
      { "name": "update_delete", "canonical": "action", "note": "Update / PartialUpdate / Delete" }
    ]
  },
  {
    "id": "amazon-inventory-loader",
    "name": "Amazon Inventory Loader",
    "file": "Inventory Loader flat file",
    "summary": "A short, offer-only template. It updates price, quantity and condition on SKUs that already exist; it cannot create new products in the catalog.",
    "notes": [
      "Create the product with a category template first, then maintain it with Inventory Loader.",
      "add-delete is blank for an update, 'x' to delete the listing.",
      "Leave quantity blank for FBA SKUs - warehouse stock is not settable from a feed.",
      "fulfillment-center-id is DEFAULT for merchant-fulfilled inventory."
    ],
    "columns": [
      { "name": "sku", "canonical": "sku", "required": true },
      { "name": "product-id", "canonical": "gtin" },
      { "name": "product-id-type", "canonical": "gtinType", "note": "1 = ASIN, 2 = ISBN, 3 = UPC, 4 = EAN" },
      { "name": "price", "canonical": "price", "required": true },
      { "name": "minimum-seller-allowed-price", "canonical": "minPrice" },
      { "name": "maximum-seller-allowed-price", "canonical": "maxPrice" },
      { "name": "item-condition", "canonical": "condition", "note": "11 = New, 1 = Used Like New, ..." },
      { "name": "quantity", "canonical": "quantity" },
      { "name": "add-delete", "canonical": "action", "note": "Blank to add/update, x to delete." },
      { "name": "will-ship-internationally" },
      { "name": "expedited-shipping" },
      { "name": "item-note", "canonical": "shortDescription", "note": "Condition note shown on the offer." },
      { "name": "fulfillment-center-id", "note": "DEFAULT for merchant-fulfilled, AMAZON_NA for FBA." },
      { "name": "product_tax_code" },
      { "name": "leadtime-to-ship" },
      { "name": "merchant-shipping-group-name" }
    ]
  },
  {
    "id": "ebay",
    "name": "eBay File Exchange",
    "file": "File Exchange listing CSV",
    "summary": "eBay's bulk CSV. The first column carries the action plus the site, country, currency and schema version. Item specifics are supplied as C:<Name> columns.",
    "notes": [
      "The Action header includes site metadata, e.g. Action(SiteID=US|Country=US|Currency=USD|Version=1193).",
      "CustomLabel is your own SKU and is what you match on for later revisions.",
      "Category takes eBay's numeric category ID, not a name.",
      "Add extra item specifics by adding more C:<Name> columns - C:Brand, C:MPN, C:Colour.",
      "PicURL accepts several URLs separated by a pipe character."
    ],
    "columns": [
      { "name": "Action(SiteID=US|Country=US|Currency=USD|Version=1193)", "canonical": "action", "required": true, "note": "Add / Revise / End / Relist" },
      { "name": "CustomLabel", "canonical": "sku" },
      { "name": "Category", "canonical": "category", "required": true, "note": "Numeric eBay category ID." },
      { "name": "StoreCategory" },
      { "name": "Title", "canonical": "title", "required": true, "note": "80 characters maximum." },
      { "name": "Subtitle" },
      { "name": "Relationship", "canonical": "relationshipType", "note": "Variation for multi-variation listings." },
      { "name": "RelationshipDetails", "canonical": "variationTheme" },
      { "name": "*ConditionID", "canonical": "condition", "required": true, "note": "1000 = New, 3000 = Used, ..." },
      { "name": "PicURL", "canonical": "imageMain" },
      { "name": "Description", "canonical": "description", "required": true },
      { "name": "Format", "note": "FixedPrice / Auction" },
      { "name": "Duration", "note": "GTC for fixed price." },
      { "name": "StartPrice", "canonical": "price", "required": true },
      { "name": "BuyItNowPrice", "canonical": "compareAtPrice" },
      { "name": "Quantity", "canonical": "quantity", "required": true },
      { "name": "Location", "canonical": "location" },
      { "name": "PayPalAccepted" },
      { "name": "PayPalEmailAddress" },
      { "name": "ShippingType", "note": "Flat / Calculated / Freight" },
      { "name": "ShippingService-1:Option" },
      { "name": "ShippingService-1:Cost", "canonical": "shippingCost" },
      { "name": "DispatchTimeMax", "note": "Handling days." },
      { "name": "ReturnsAcceptedOption" },
      { "name": "RefundOption" },
      { "name": "ReturnsWithinOption" },
      { "name": "ShippingCostPaidByOption" },
      { "name": "ProductID", "canonical": "gtin", "note": "UPC / EAN / ISBN." },
      { "name": "C:Brand", "canonical": "brand" },
      { "name": "C:MPN", "canonical": "mpn" },
      { "name": "C:Colour", "canonical": "option1Value" },
      { "name": "C:Size", "canonical": "option2Value" }
    ]
  },
  {
    "id": "etsy",
    "name": "Etsy",
    "file": "Etsy listings CSV (Download Data export)",
    "summary": "Etsy exports currently-for-sale listings as a CSV. Etsy does not offer an official CSV route for creating listings, so treat this schema as a data-portability and backup format.",
    "notes": [
      "Etsy has no bulk CSV import for new listings - use this to move data out, or into a third-party lister.",
      "TAGS and MATERIALS are comma separated; Etsy allows up to 13 tags.",
      "Each listing supports up to 10 image URLs.",
      "Variation columns hold a type, a name and a comma separated list of values."
    ],
    "columns": [
      { "name": "TITLE", "canonical": "title", "required": true, "note": "140 characters maximum." },
      { "name": "DESCRIPTION", "canonical": "description", "required": true, "note": "Plain text, no HTML." },
      { "name": "PRICE", "canonical": "price", "required": true },
      { "name": "CURRENCY_CODE", "canonical": "currency", "note": "ISO code, e.g. USD." },
      { "name": "QUANTITY", "canonical": "quantity", "required": true },
      { "name": "TAGS", "canonical": "tags", "note": "Up to 13, comma separated." },
      { "name": "MATERIALS", "canonical": "materials" },
      { "name": "IMAGE1", "canonical": "imageMain" },
      { "name": "IMAGE2", "canonical": "image2" },
      { "name": "IMAGE3", "canonical": "image3" },
      { "name": "IMAGE4", "canonical": "image4" },
      { "name": "IMAGE5", "canonical": "image5" },
      { "name": "VARIATION 1 TYPE", "canonical": "option1Name" },
      { "name": "VARIATION 1 NAME", "canonical": "option1Label" },
      { "name": "VARIATION 1 VALUES", "canonical": "option1Value" },
      { "name": "VARIATION 2 TYPE", "canonical": "option2Name" },
      { "name": "VARIATION 2 NAME", "canonical": "option2Label" },
      { "name": "VARIATION 2 VALUES", "canonical": "option2Value" },
      { "name": "SKU", "canonical": "sku" }
    ]
  },
  {
    "id": "woocommerce",
    "name": "WooCommerce",
    "file": "WooCommerce product CSV importer",
    "summary": "WooCommerce ships with a built-in CSV importer. Variable products use a parent row of Type 'variable' plus child rows of Type 'variation' that reference the parent by SKU.",
    "notes": [
      "Type is one of simple, variable, variation, grouped or external.",
      "Boolean columns take 1 / 0.",
      "Images is a comma separated list of URLs; the first is the featured image.",
      "Categories support hierarchy with '>' and multiple values with commas.",
      "Column headers are human readable and can be remapped in the importer UI."
    ],
    "columns": [
      { "name": "ID", "note": "Leave blank when creating new products." },
      { "name": "Type", "required": true, "note": "simple / variable / variation — a WooCommerce keyword, not your own product type." },
      { "name": "SKU", "canonical": "sku", "required": true },
      { "name": "Name", "canonical": "title", "required": true },
      { "name": "Published", "canonical": "published", "note": "1 / 0 / -1 for draft." },
      { "name": "Is featured?", "note": "1 / 0" },
      { "name": "Visibility in catalog", "note": "visible / catalog / search / hidden" },
      { "name": "Short description", "canonical": "shortDescription" },
      { "name": "Description", "canonical": "description" },
      { "name": "Tax status", "note": "taxable / shipping / none" },
      { "name": "Tax class" },
      { "name": "In stock?", "note": "1 / 0" },
      { "name": "Stock", "canonical": "quantity" },
      { "name": "Backorders allowed?", "note": "1 / 0 / notify" },
      { "name": "Weight (kg)", "canonical": "weight" },
      { "name": "Length (cm)", "canonical": "length" },
      { "name": "Width (cm)", "canonical": "width" },
      { "name": "Height (cm)", "canonical": "height" },
      { "name": "Allow customer reviews?", "note": "1 / 0" },
      { "name": "Sale price", "canonical": "salePrice" },
      { "name": "Regular price", "canonical": "price", "required": true },
      { "name": "Categories", "canonical": "category", "note": "Parent > Child, comma separated for multiple." },
      { "name": "Tags", "canonical": "tags" },
      { "name": "Shipping class" },
      { "name": "Images", "canonical": "imageMain", "note": "Comma separated URLs, first one is featured." },
      { "name": "Parent", "canonical": "parentSku", "note": "Parent SKU for variation rows." },
      { "name": "Position", "note": "Menu order." },
      { "name": "Brand", "canonical": "brand" },
      { "name": "GTIN, UPC, EAN, or ISBN", "canonical": "gtin" },
      { "name": "Attribute 1 name", "canonical": "option1Name" },
      { "name": "Attribute 1 value(s)", "canonical": "option1Value" },
      { "name": "Attribute 1 visible", "note": "1 / 0" },
      { "name": "Attribute 2 name", "canonical": "option2Name" },
      { "name": "Attribute 2 value(s)", "canonical": "option2Value" },
      { "name": "Attribute 2 visible", "note": "1 / 0" }
    ]
  }
]
